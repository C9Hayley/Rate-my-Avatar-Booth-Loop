local function input(y, widthScale, hint, start)
	local tb = new("TextBox", {
		Text = start or "",
		PlaceholderText = hint,
		PlaceholderColor3 = col.dim,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = col.text,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundColor3 = col.field,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(widthScale, widthScale < 1 and -6 or 0, 0, 28),
	}, content)
	corner(tb)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, tb)
	return tb
end

