local function drawList()
	for _, c in ipairs(listBox:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	for i, t in ipairs(cfg.texts) do
		local row = new("Frame", {
			Size = UDim2.new(1, -4, 0, 24),
			BackgroundColor3 = col.field,
			BorderSizePixel = 0,
			LayoutOrder = i,
		}, listBox)
		corner(row, 4)
		new("TextLabel", {
			Text = i .. ".  " .. t,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = col.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(8, 0),
			Size = UDim2.new(1, -34, 1, 0),
		}, row)
		local x = new("TextButton", {
			Text = "x",
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = col.red,
			BackgroundTransparency = 1,
			Position = UDim2.new(1, -26, 0, 0),
			Size = UDim2.fromOffset(24, 24),
		}, row)
		table.insert(conns, x.MouseButton1Click:Connect(function()
			table.remove(cfg.texts, i)
			if cfg.pos > #cfg.texts then cfg.pos = 1 end
			drawList()
		end))
	end
end

local function setBooth(desc)
	local event = RS:WaitForChild("Remotes"):WaitForChild("CommitBoothDraft")
	event:InvokeServer({
		image = "",
		accentColor = Color3.new(0.6392157, 0.6352941, 0.6470588),
		primaryColor = "default",
		booth = "Default Booth",
		desc = desc,
		blacklist = {},
	})
end

local function stop()
	cfg.running = false
	runId += 1
	runBtn.Text = "Start"
	runBtn.BackgroundColor3 = col.green
	say("stopped")
end

local function start()
	if #cfg.texts == 0 then
		say("add at least one text first", col.red)
		return
	end
	cfg.running = true
	runId += 1
	local me = runId
	runBtn.Text = "Stop"
	runBtn.BackgroundColor3 = col.red

	task.spawn(function()
		while cfg.running and runId == me do
			local t = cfg.texts[cfg.pos]
			local ok, err = pcall(setBooth, t)
			if ok then
				say("set: " .. t, col.green)
			else
				say("failed, check console", col.red)
				warn("[TextLooper] " .. tostring(err))
			end
			cfg.pos = cfg.pos % #cfg.texts + 1

			local t0 = 0
			while t0 < cfg.delay and cfg.running and runId == me do
				t0 += task.wait(0.1)
			end
		end
	end)
end

local function panic()
	if dead then return end
	dead = true
	cfg.running = false
	runId += 1
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(conns)
	gui:Destroy()
end

local function tryAdd()
	local t = newText.Text
	if t:gsub("%s", "") == "" then
		say("can't add an empty text", col.red)
		return
	end
	table.insert(cfg.texts, t)
	newText.Text = ""
	drawList()
end

table.insert(conns, addBtn.MouseButton1Click:Connect(tryAdd))
table.insert(conns, newText.FocusLost:Connect(function(enter)
	if enter then tryAdd() end
end))

table.insert(conns, delayBox.FocusLost:Connect(function()
	local n = tonumber(delayBox.Text)
	if n and n >= 1 then
		cfg.delay = n
	else
		delayBox.Text = tostring(cfg.delay)
		say("delay needs to be 1 or more", col.red)
	end
end))

table.insert(conns, keyBtn.MouseButton1Click:Connect(function()
	cfg.rebinding = true
	keyBtn.Text = "press a key..."
end))

table.insert(conns, runBtn.MouseButton1Click:Connect(function()
	if cfg.running then stop() else start() end
end))

table.insert(conns, panicBtn.MouseButton1Click:Connect(panic))

table.insert(conns, UIS.InputBegan:Connect(function(inp, typing)
	if cfg.rebinding and inp.UserInputType == Enum.UserInputType.Keyboard then
		cfg.key = inp.KeyCode
		keyBtn.Text = inp.KeyCode.Name
		cfg.rebinding = false
		return
	end
	if typing then return end
	if inp.KeyCode == cfg.key then
		win.Visible = not win.Visible
	end
end))

-- drag by the title bar
do
	local dragging, origin, startMouse
	table.insert(conns, bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startMouse = i.Position
			origin = win.Position
		end
	end))
	table.insert(conns, UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
			or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startMouse
			win.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
		end
	end))
	table.insert(conns, UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

drawList()
